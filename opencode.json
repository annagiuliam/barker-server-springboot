{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",

    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "**/*.env": "deny",
      "*.env.*": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow"
    },
    "edit": "ask",
    "bash": "ask",
    "glob": "ask",
    "grep": "ask",
    "list": "ask",

    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",

    "task": "ask",
    "skill": "ask",
    "lsp": "ask",
    "todoread": "ask",
    "todowrite": "ask",

    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
